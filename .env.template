# Copy to .env and fill in. .env is gitignored.

# Tinker: LoRA training, sampling every model in the paper, and recall.
TINKER_API_KEY=

# OpenRouter (pinned to the OpenAI upstream): corpus generation (GPT-5.6 Luna), recall question generation and
# grading, the ODCV, EvilGenie and MASK judges, and every `sdf scan` screen (the belief classifiers, doxxing).
OPENROUTER_API_KEY=

# OpenAI: the judges that need a structured (JSON-schema) verdict, which OpenRouter does not pass through, so they
# call OpenAI directly: the toy honesty judge and the sandbagging judges (experiments/sandbagging/judges.py).
OPENAI_API_KEY=

# Optional.
# Anthropic: only for evals/agentic_misalignment's own scorer (inspect_evals' default Claude grader), which none of
# the paper's numbers use.
ANTHROPIC_API_KEY=
# Weights & Biases: training and eval logging; everything runs without it.
WANDB_API_KEY=
